# ========================================
# Application Settings
# ========================================
PROJECT_NAME=Life Tracker API
VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=true

# ========================================
# Server Settings
# ========================================
HOST=0.0.0.0
PORT=8000

# ========================================
# Database Settings
# ========================================
# Docker (when using docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:change_me_in_production@db:5432/life_tracker

# Local PostgreSQL (when running locally)
# DATABASE_URL=postgresql+asyncpg://postgres:change_me_in_production@localhost:5432/life_tracker

# ========================================
# Security Settings
# ========================================
# IMPORTANT: Generate a new secret key for production!
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32

ALGORITHM=HS256

# Token expiry (in seconds)
ACCESS_TOKEN_EXPIRE_SECONDS=3600        # 1 hour
REFRESH_TOKEN_EXPIRE_SECONDS=2592000    # 30 days

# ========================================
# CORS Settings
# ========================================
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ========================================
# AI Service (Anthropic Claude)
# ========================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ========================================
# Logging
# ========================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ========================================
# PostgreSQL Settings (for docker-compose)
# ========================================
POSTGRES_DB=mood_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# ========================================
# pgAdmin Settings (optional)
# ========================================
PGADMIN_EMAIL=admin@moodtracker.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ========================================
# Application Port
# ========================================
APP_PORT=8000

# ========================================
# Rate Limiting (Future)
# ========================================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60