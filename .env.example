# ========================================
# Application Settings
# ========================================
PROJECT_NAME=Life Tracker API
VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=true

# ========================================
# Server Settings
# ========================================
HOST=0.0.0.0
PORT=8000

# ========================================
# Database Settings
# =======================================
# Local PostgreSQL (when running locally)
DATABASE_URL=postgresql://postgres:change_me_in_production@localhost:5432/lumenary

# ========================================
# Security Settings
# ========================================
# IMPORTANT: Generate a new secret key for production!
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
TOKEN_PEPPER=your-token-pepper-change-this-in-production-use-openssl-rand-hex-32

# ========================================
# CORS Settings
# ========================================
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# ========================================
# AI Service (Anthropic Claude)
# ========================================
GEMINI_API_KEY=change-api-key-in-production
GEMINI_MODEL=gemini-3-flash-preview

# ========================================
# Logging
# ========================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ========================================
# PostgreSQL Settings (for docker-compose)
# ========================================
POSTGRES_DB=lumenary
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# ========================================
# Application Port
# ========================================
APP_PORT=8000
